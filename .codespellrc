# SPDX-License-Identifier: Apache-2.0 OR MIT
# Spelling check for the docs-lint job (`make docs-lint`). Generated and
# vendored files are skipped, and so are the binary fuzz inputs.
[codespell]
skip = ./target,./.git,./.mvn,./LICENSES,./KEYS.asc,./src/test/resources/com/jspassgen/SecureRandomSourceFuzzTestInputs
